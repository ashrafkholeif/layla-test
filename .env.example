# Layla v2 - Environment Variables
# Copy this to .env and fill in your values

# ==================
# DATABASE
# ==================
DATABASE_URL=postgresql://username:password@localhost:5432/layla_v2

# ==================
# OPENAI
# ==================
OPENAI_API_KEY=sk-your-api-key-here

# ==================
# TWILIO
# ==================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+1234567890

# ==================
# SERVER
# ==================
PORT=3000
NODE_ENV=development

# ==================
# DEPLOYMENT (Render)
# ==================
# For Render PostgreSQL, DATABASE_URL will be provided automatically
# Just copy it from your Render PostgreSQL dashboard
